	(text "The SD2 bank (NVCC_SD2) is 3.3V, shared with the FlexSPI flash (now the 3.3V W25Q512JVEIQ): default-speed / high-speed only, no UHS-I 1.8V signalling."
		(exclude_from_sim no)
		(at 25.4 143 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
