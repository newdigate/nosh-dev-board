	)
	(text "microSD on uSDHC2 (GPIO_SD_B2_00..05: DATA3, DATA2, DATA1, DATA0, CLK, CMD), its own bus - the EVKB shares uSDHC1 between the M.2 socket and J15."
		(exclude_from_sim no)
		(at 25.4 139.7 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "c5cb4a43-7dbb-4675-bc09-3588df7bfc4f")
	)
	(text "Per EVKB sheets 5/11: 10k pull-ups on CMD/DAT0, 100k DAT3 pull-down, 0R CLK series with DNP 18pF cap (EVKB C247), IRLML6401 high-side switch (10k/1k/0.22uF), 1uF+2.2uF+0.1uF, 1k bleed."
		(exclude_from_sim no)
		(at 25.4 146.3 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "f1b32344-43a6-44ac-bbed-a96c3661c494")
	)
