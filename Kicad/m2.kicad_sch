	)
	(text "M.2 Key E socket for the u-blox MAYA-W1 (NXP IW416) Wi-Fi/BT card, wired as MIMXRT1170-EVKB sheet 23 but on a DEDICATED SDIO bus: uSDHC1 (GPIO_SD_B1_00..05) with NVCC_SD1 = +1V8,"
		(exclude_from_sim no)
		(at 25.4 215.9 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "7295cafb-1572-469f-8bb8-37b10b18e4cc")
	)
	(text "U11: MCU (3.3V) -> module (1.8V)"
		(exclude_from_sim no)
		(at 149.86 50.8 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "8507c798-f14b-49ae-9c3b-46f98a0d13fd")
	)
	(text "M.2 KEY E SOCKET  (uSDHC1, 1.8V)"
		(exclude_from_sim no)
		(at 25.4 38.1 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "8c707bc8-4e35-4bfa-883c-ac56561daeb3")
	)
	(text "H5: M2.5 SMT round nut, 2 mm high, YIYUAN SMTSOM2.520BTR (LCSC C5301776). Land: 4.22 mm plated hole, 6.2 mm GND pad, EVKB BH1 paste ring."
		(exclude_from_sim no)
		(at 246.38 138.43 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9d0d6eab-39cd-403e-b50c-a77f8f146fad")
	)
	(text "MCU pins: SDIO_RST = GPIO_AD_16, WL_DEV_WAKE = GPIO_AD_07, BT_DEV_WAKE = GPIO_AD_28, UART_WAKE -> BT_WAKE_B = GPIO_AD_27, SDIO_WAKE -> WIFI_WAKE_B = GPIO_AD_29 (EVKB: header J104). UART = LPUART2 (GPIO_DISP_B2_10..13)."
		(exclude_from_sim no)
		(at 25.4 232.4 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "adbb8d06-fe93-4eeb-84cc-b3df1eefe59e")
	)
