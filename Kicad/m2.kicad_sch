		(uuid "11fe7eb8-b755-463d-a219-d2bdeda6167c")
	)
	(text "Place it 30 mm from the centre of J6's signal pads, on J6's centre line (EVKB: BH1 to J54)."
		(exclude_from_sim no)
		(at 246.38 140.97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "233c0802-8904-408e-a46d-fc844461b920")
	)
	(text "so the card runs at its native 1.8V with no VSELECT mux and no shared microSD slot. M2Radio (SdioHost: uSDHC1, SDIO_RST = GPIO_AD_16, WL_RST/PDn = GPIO_AD_31, BT HCI on LPUART2) works unchanged."
		(exclude_from_sim no)
		(at 25.4 219.2 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "23e45600-1568-4981-b275-0d279707b98d")
	)
	(text "W_DISABLE1/2 are 3.3V-tolerant open-drain inputs on the card: 10k to WL_3V3 + 0.1uF + 27R series (EVKB R829-R834, C323/C324); driven from GPIO_AD_31 (WL_RST_B, the EVKB hand-bridged R404) and GPIO_AD_15 (BT_RST_B)."
		(exclude_from_sim no)
		(at 25.4 229.1 0)
		(effects
