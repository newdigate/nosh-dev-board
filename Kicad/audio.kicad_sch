				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "191296c4-c4da-4a02-b331-4a3f2354eeaa")
	)
	(text "SAI1 (GPIO_AD_17..23) as on the EVKB: MCLK->MCLK/XTI, TX_BCLK->BCLK, TX_SYNC->LRCLK, TXD0->DACDAT, RXD0->ADCDAT; RX_BCLK/RX_SYNC links R84/R85 are DNP (synchronous mode, EVKB R2124/R2125)."
		(exclude_from_sim no)
		(at 149.86 40.64 0)
