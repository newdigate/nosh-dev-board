	)
	(text "Control on LPI2C5, shared with the touch panel (2.2k pull-ups on the LCD sheet). The touch controller uses 0x14/0x5D, so no address clash."
		(exclude_from_sim no)
		(at 149.86 48.26 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "243c4bce-3ea1-43f6-b564-6802eb9d6ee2")
	)
	(text "SAI1 LINKS  (R84/R85 DNP: RX runs synchronous to TX)"
		(exclude_from_sim no)
		(at 162.56 196.85 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "4fef1772-88f1-4907-a088-b31410c3d256")
	)
	(text "SUPPLIES AND REFERENCE  (VDDD 1.8 V, VDDA filtered 3.3 V, VDDIO 3.3 V, VAG; caps close to U15)"
		(exclude_from_sim no)
		(at 162.56 154.94 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "61e58fae-9647-461a-a4e9-7cb53f354bbe")
	)
	(text "This matches the Teensy library defaults: CHIP_ANA_POWER 0x4060 (VDDD driven externally) and CHIP_LINREG_CTRL 0x006C (VDDA and VDDIO above 3.1 V); no CPFILT on the QFN-20."
		(exclude_from_sim no)
		(at 149.86 55.88 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "8d13e225-86fa-4c16-936c-b48d12ef92aa")
	)
	(text "LINE IN  (LINEIN_L/R, 1uF DC blocking)"
		(exclude_from_sim no)
		(at 231.14 237.49 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "9d2b8dc1-39b3-4902-9684-fe20b0a77890")
	)
	(text "U15 SGTL5000XNLA3R2  (Teensy Audio Shield codec; I2C 0x0A)"
		(exclude_from_sim no)
		(at 25.4 38.1 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "b6a0eab3-2539-4887-8f51-eea43603bc5a")
	)
	(text "Line out: LINEOUT_L/R through 1uF to J8, line level into >= 10k. Line in: J9 through 1uF into LINEIN_L/R. HP_L/HP_R/HP_VGND and MIC/MIC_BIAS unused; HP_VGND must never be grounded."
		(exclude_from_sim no)
		(at 149.86 59.69 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "d71fad56-4dc4-4acf-8f2c-35bf41b881bb")
	)
	(text "QFN-20 SGTL5000: Teensy Audio library AudioControlSGTL5000 and the NXP SDK sgtl5000 driver both apply. I2C address is fixed at 0x0A on the QFN-20 (no ADR0 pin, no SPI)."
		(exclude_from_sim no)
		(at 149.86 40.64 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "e4d5bc89-664c-4d6a-91b3-a726eec10871")
	)
	(text "AUDIO: SGTL5000 stereo codec (QFN-20) on SAI1 + LPI2C5 with 3.5mm line-out and line-in jacks. No microphone or headphone amplifier in use."
		(exclude_from_sim no)
		(at 25.4 25.4 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "e8db7a5f-ee2c-4f7a-b7b1-2418c4a88b94")
	)
	(text "Supplies per datasheet Fig. 20: VDDD = external 1.8 V (CODEC_1V8 via R79) + 100nF; VDDIO = +3V3 + 100nF; VDDA = +3V3 through FB11 + 4.7uF + 100nF; VAG 100nF."
		(exclude_from_sim no)
		(at 149.86 52.07 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "f31bae04-f425-4f9d-876a-7b8686f795c8")
	)
	(text "SAI1 (GPIO_AD_17..23) unchanged: MCLK->SYS_MCLK, TX_BCLK->I2S_SCLK, TX_SYNC->I2S_LRCLK, TXD0->I2S_DIN, I2S_DOUT->RXD0; RX_BCLK/RX_SYNC links R84/R85 DNP (synchronous mode)."
		(exclude_from_sim no)
		(at 149.86 44.45 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
