	(footprint "Nosh:C_0402_1005Metric_ViP"
		(layer "B.Cu")
		(uuid "3deaadad-7eab-4e09-8061-587b51441590")
		(at 72.4 43.6 -90)
		(descr "Capacitor SMD 0402 (1005 Metric) for via-in-pad under U1 (MIMXRT1176, 0.8 mm ball pitch): pad centres 0.8 mm apart so each pad sits on a fan-out via of the BGA via lattice, as on the MIMXRT1170-EVKB. Pads 0.5 x 0.55 mm. Courtyard 1.4 x 0.66 mm so caps fit on adjacent lattice rows. Reference on F.Fab only (no silk under the BGA). Pads take no zone connection (each sits on its via, and the copper pour under the BGA is fragments). Needs filled and capped vias (JLCPCB POFV, free on 6+ layers).")
