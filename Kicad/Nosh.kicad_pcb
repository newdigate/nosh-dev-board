	(gr_text "SDRAM plan (EVKB arrangement, see README): channel between U9 (north) and U10 (south) | SIG = address trunks, one via onto bottom links at each pin x (group B offset +0.4) | TOP = D8-15/DM1 to U9 south row, D16-23/DM2 to U10 north row | BOTTOM = D0-7/DM0 to U9 north-row vias, D24-31/DM3 to U10 south-row vias | clock: J3 -> R41/R42 -> pin 38 | match to CLK +-5 mm | no tracks on GND1/PWR/GND2"
		(at 26 12.5 0)
		(layer "Cmts.User")
		(uuid "5ceb3ded-33a0-4484-a847-3e385fd9b76a")
