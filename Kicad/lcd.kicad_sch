	(text "GPIO map (NXP board.h / MipiDisplay panel_gpio.h): LCD reset GPIO_AD_02, backlight GPIO_AD_30, panel power GPIO_DISP_B2_15, touch INT GPIO_AD_00, touch RST GPIO_AD_01,"
		(exclude_from_sim no)
		(at 25.4 158.75 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "1aa313fe-09f8-4747-8501-2775ff95a6a8")
	)
	(text "Boost output on BL_PLUS (also the OVP sense), LED return on BL_MINUS/FB. SHDN = BACKLIGHT_CTL (GPIO_AD_30) with 100k pull-down; PWM dimming 500Hz-50kHz possible."
		(exclude_from_sim no)
		(at 149.86 134.81 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "311f0694-52b9-4530-9b07-a7a7258d4e80")
	)
	(text "CONTROL LINES  (EVKB R405/R847, R848/R1825, R1849+D32, R414, R1026/R1027, R2031/R2032)"
		(exclude_from_sim no)
		(at 25.4 198.12 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "341153db-ab7d-4aa1-b089-07c0c263ebf3")
	)
	(text "CTP I2C on LPI2C5 with 4.7k pull-ups to +3V3 (NVCC_LPSR = 3.3V on both boards). LCM_PWR_EN 10k pull-up to +3V3 (EVKB R1825); R67/R64/R72/R76/R77 are the EVKB 0R isolation links."
		(exclude_from_sim no)
		(at 90.17 257.81 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "36d6a78f-1522-4e2c-bb10-9fad11e00a7a")
	)
	(text "BACKLIGHT BOOST  (EVKB U46 circuit)  -  DNP: the RK055HDMIPI4MA0 adapter carries its own boost (SPF-39012 U1, J5/J3 default 1-2)"
		(exclude_from_sim no)
		(at 149.86 60.96 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "39f2e56b-9510-40c2-97e7-f1339777a4d1")
	)
	(text "LCD_TE: the tearing-effect output is 1.8V logic; the EVKB shifts it to 3.3V with U355 (74AVC8T245). Not used by the driver (DSI video mode), so R67 is DNP - add a shifter if TE is ever needed."
		(exclude_from_sim no)
		(at 90.17 254 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "49737042-fb82-4d2a-9302-aa916a6a8c3b")
	)
	(text "touch I2C = LPI2C5 (GPIO_LPSR_04/05), TE GPIO_AD_05. GT911 touch I2C 7-bit address 0x5D or 0x14 (EVKB note: 0xBA/0xBB or 0x28/0x29 as 8-bit)."
		(exclude_from_sim no)
		(at 25.4 162.56 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "64214812-0240-4015-925b-9aacb883e1a6")
	)
	(text "Pins 1/2 (LEDK/LEDA), 23 (2.8V), 25 (1.8V), 30 (3.3V): only used when the adapter jumpers J5/J3, J6, J8, J7 are set 2-3 (external supply); default 1-2 = generated on the adapter from the 5V."
		(exclude_from_sim no)
		(at 25.4 151.13 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "64c81042-617c-450d-a409-b6a645962af5")
	)
	(text "Fit U13/L6/D8/C120-C123/R61-R63/R65/R78 only for an externally driven backlight (adapter J5/J3 at 2-3) or a bare panel. UM1663S: 200mV FB, R61||R62 = 5R -> 40mA (panel typ. 22.4V @ 40mA, 10 LEDs)."
		(exclude_from_sim no)
		(at 149.86 131 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "843fe004-8f92-4289-acb5-add1397cfc02")
	)
	(text "RAIL LINKS  (EVKB R1827/R1826/R846)"
		(exclude_from_sim no)
		(at 25.4 246.38 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "88f1979e-c654-425e-bd88-f8f3148e6832")
	)
	(text "MIPI DSI: 2 data lanes + clock straight from U1 (A8/B8, A10/B10, A9/B9). 100R differential pairs, length-matched, no stubs; lanes 2/3 unused on the RT1176 (EVKB test resistors omitted)."
		(exclude_from_sim no)
		(at 25.4 154.94 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "8abd33e8-019f-4261-8709-7abc18d3d56e")
	)
	(text "PANEL VDD 2.8V  (EVKB U2)  -  DNP, adapter J6 default 1-2 = on-board LDO"
		(exclude_from_sim no)
		(at 240.03 147.32 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "94259cee-0903-4601-98e3-e6c224811254")
	)
	(text "MIPI DSI LCD + TOUCH: Rocktech RK055HDMIPI4MA0 (RK055MHD091A0-CTG 720x1280 HX8394, GT911 CTP) on a 40-pin 0.5mm FPC - replica of MIMXRT1170-EVKB J48"
		(exclude_from_sim no)
		(at 25.4 25.4 0)
		(effects
			(font
				(size 1.5 1.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "a4fba0c0-36e0-4454-87a1-12bad4383c28")
	)
	(text "LCD_RST: GPIO_AD_02 (3.3V) drives the 1.8V LRSTB input through D9 with a 10k pull-up to +1V8 (EVKB R1849/D32): open-drain style level translation, no shifter."
		(exclude_from_sim no)
		(at 90.17 250.19 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "da5c3c7f-83de-4762-b654-9f39b8749999")
	)
	(text "J7: 40-PIN 0.5mm FPC (EVKB J48, Wuerth 68714014022)"
